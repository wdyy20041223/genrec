# Shared local text-encoder paths for TIGER's SID preprocessing.
# This file defines common macros for model paths.
#
# You can override these paths in two ways:
# Override via command line:
#    --gin "MODEL_HUB_SENTENCE_T5_XL='/your/path/sentence-t5-xl'"
#
# Defaults are local folders relative to the repository working directory.
# Prepare the model files yourself, or override a macro with a model identifier.

# Sentence-T5 models (for text encoding)
MODEL_HUB_SENTENCE_T5_BASE = "./models_hub/sentence-t5-base"
MODEL_HUB_SENTENCE_T5_XL = "./models_hub/sentence-t5-xl"
